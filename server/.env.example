# ─────────────────────────────────────────────────────────────
# Backend environment variables (copy to .env and fill in values)
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Neon) connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Get this from your Neon dashboard → Connection Details → Prisma
DATABASE_URL="postgresql://neondb_owner:npg_a5pkvmEtA9MV@ep-odd-bread-axqg5oit-pooler.c-4.us-east-2.aws.neon.tech/student_directory?sslmode=require&channel_binding=require"

# Server
PORT=5000

# Auth
JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="1d"

# CORS — frontend origin
CLIENT_ORIGIN="http://localhost:5173"

# Default admin (used by seed script)
ADMIN_EMAIL="admin@classportal.com"
ADMIN_PASSWORD="Admin@12345"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Class Student Directory <your-sender@gmail.com>"

GEMINI_API_KEY=
