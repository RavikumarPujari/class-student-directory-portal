generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id             String    @id @default(cuid())
  name           String
  usn            String    @unique
  section        String?
  branch         String?
  year           String?
  semester       Int?
  phone          String?
  email          String    @unique
  linkedin       String?
  github         String?
  portfolio      String?
  favoriteDomain String?   @map("favorite_domain")
  skills         String?
  bio            String?
  photo          String?
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  passwordHash   String?   @map("password_hash")

  ledTeams         Team[]           @relation("TeamLeader")
  teamMemberships  TeamMember[]     @relation("StudentMemberships")
  teamInvitations  TeamInvitation[] @relation("StudentInvitations")
  sentTeamMessages TeamMessage[]    @relation("StudentTeamMessages")
  aiMessages       TeamAIMessage[]  @relation("StudentAIMessages")
  notifications    Notification[]   @relation("StudentNotifications")

  @@map("students")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String   @default("Administrator")
  role         String   @default("admin") // admin or government
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Team {
  id             String             @id @default(cuid())
  name           String
  description    String?
  requiredSkills String?            @map("required_skills")
  leaderId       String             @map("leader_id")
  maxSize        Int                @default(5) @map("max_size")
  approvalStatus TeamApprovalStatus @default(APPROVED) @map("approval_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  leader             Student          @relation("TeamLeader", fields: [leaderId], references: [id])
  members            TeamMember[]     @relation("TeamMembers")
  invitations        TeamInvitation[] @relation("TeamInvitations")
  messages           TeamMessage[]    @relation("TeamMessages")
  aiMessages         TeamAIMessage[]  @relation("TeamAIMessages")
  roadmap            Json?
  roadmapGeneratedAt DateTime?        @map("roadmap_generated_at")

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id")
  studentId String   @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  team    Team    @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation("StudentMemberships", fields: [studentId], references: [id])

  @@unique([teamId, studentId])
  @@map("team_members")
}

model TeamInvitation {
  id        String           @id @default(cuid())
  teamId    String           @map("team_id")
  studentId String           @map("student_id")
  status    InvitationStatus @default(PENDING)
  token     String           @unique
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  team    Team    @relation("TeamInvitations", fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation("StudentInvitations", fields: [studentId], references: [id])

  @@map("team_invitations")
}

model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  senderId  String   @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team   Team    @relation("TeamMessages", fields: [teamId], references: [id], onDelete: Cascade)
  sender Student @relation("StudentTeamMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdAt])
  @@map("team_messages")
}

enum NotificationType {
  TEAM_INVITATION
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  TEAM_MEMBER_JOINED
  TEAM_MESSAGE
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String           @map("recipient_id")
  type        NotificationType
  title       String
  message     String
  referenceId String?          @map("reference_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient Student @relation("StudentNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([createdAt])
  @@index([isRead])
  @@map("notifications")
}

model AccessLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  targetId  String?  @map("target_id")
  action    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([createdAt])
  @@map("access_logs")
}

model TeamAIMessage {
  id               String   @id @default(cuid())
  teamId           String   @map("team_id")
  askedByStudentId String   @map("asked_by_student_id")
  question         String
  answer           String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  team    Team    @relation("TeamAIMessages", fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation("StudentAIMessages", fields: [askedByStudentId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdAt])
  @@map("team_ai_messages")
}
